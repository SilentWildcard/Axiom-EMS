# ERS — Emergency Response Synchronization System
# Environment Variable Template

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry
VITE_CITY=Delhi
VITE_DEMO_MODE=true

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,https://*.vercel.app
ENVIRONMENT=development
ERS_SECRET_KEY=change_in_production_secret_key_8f93a1

# Hardware IoT Gateway (For real ESP32 / Arduino devices)
MQTT_BROKER_HOST=mqtt.delhitrafficpolice.gov.in
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
IOT_AUTH_TOKEN=ers_rsu_token_delhi_sec_8f93a1
